# Copie para .env (ou .env.local) e ajuste. Nada de segredos aqui: toda variavel VITE_
# vai junto no codigo que o navegador baixa.

# URL da sauf-api, com o prefixo /api/v1. A origem do front (ex.: http://localhost:5173)
# precisa estar no SAUF_CORS_ORIGENS da API, porque o login usa cookie.
VITE_API_URL=http://localhost:8080/api/v1

# So em desenvolvimento: libera as telas de Simulados sem pagamento (ainda exige login).
# Ja vem ligado no .env.development; use false para testar o paywall.
# VITE_MOCK_ASSINATURA=false
